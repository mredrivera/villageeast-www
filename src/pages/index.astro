---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import facts from '~/data/community-facts.json';
import { site } from '~/data/site';
import { dateParts, fmtDate, fmtTime } from '~/lib/format';

const db = Astro.locals.supabase;
const [{ data: events }, { data: news }] = await Promise.all([
  db.from('events').select('id,title,kind,starts_at,location').gte('starts_at', new Date().toISOString()).order('starts_at').limit(4),
  db.from('announcements').select('id,title,body,published_at,pinned').eq('visibility', 'public').order('pinned', { ascending: false }).order('published_at', { ascending: false }).limit(4),
]);
const amenities = [
  { icon: 'pool', title: 'Pool & clubhouse', text: 'A seasonal pool with a clubhouse for gatherings at 402 Indian Ridge Drive.' },
  { icon: 'court', title: 'Courts', text: 'Tennis, pickleball and basketball on the multi-purpose courts.' },
  { icon: 'ramp', title: 'Private boat ramp & day dock', text: 'A gated ramp and day dock on the Roanoke River channel.' },
  { icon: 'boat', title: 'Boat & trailer storage', text: 'Two storage lots reserved for owners.' },
];
---
<Base title={site.name}>
  <section class="hero">
    <img class="hero-art" src={site.heroPhoto ?? '/hero.svg'} alt="" width="1600" height="900" fetchpriority="high" />
    <div class="wrap">
      <p class="eyebrow">Smith Mountain Lake &middot; Moneta, Virginia</p>
      <h1>Welcome to Village East</h1>
      <p>{site.tagline}: {facts.counts.lots} waterfront and water-access homes and lots on the Bedford County shore.</p>
      <div class="row mt-3">
        <a class="btn btn-accent" href="/map"><Icon name="map" size={18} /> Explore the community map</a>
        <a class="btn btn-light" href="/members">Owner area</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="stat-strip">
      <div class="stat"><div class="stat-value">{facts.counts.lots}</div><div class="stat-label">Homes &amp; lots</div></div>
      <div class="stat"><div class="stat-value">{facts.counts.homes}</div><div class="stat-label">Homes built</div></div>
      <div class="stat"><div class="stat-value">{Math.round(facts.counts.acres)}</div><div class="stat-label">Acres of community</div></div>
      <div class="stat"><div class="stat-value">R26</div><div class="stat-label">Lake channel marker</div></div>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">About our community</p>
      <div class="grid grid-2">
        <div>
          <h2>Lake life, well looked after</h2>
          <p class="lead">Village East is a community of waterfront and water-access homes and lots on Smith Mountain Lake. The association maintains every road in the subdivision along with the shared amenities that make it home.</p>
          <dl class="dl mt-3">
            <dt>By lake</dt><dd>{site.byLake}</dd>
            <dt>By land</dt><dd>{site.byLand}</dd>
            <dt>Clubhouse</dt><dd>{site.clubhouseAddress.join(', ')}</dd>
          </dl>
          <p class="mt-3"><a class="link-arrow" href="/amenities">See all amenities <Icon name="arrow" size={16} /></a></p>
        </div>
        <div class="grid grid-tight">
          {amenities.map((a) => (
            <div class="card">
              <div class="card-icon"><Icon name={a.icon} size={22} /></div>
              <h3>{a.title}</h3>
              <p class="small muted">{a.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section band-sand">
    <div class="wrap grid grid-2">
      <div>
        <div class="spread mb-2"><h2 class="mb-0">Coming up</h2><a class="link-arrow" href="/meetings">Full calendar <Icon name="arrow" size={16} /></a></div>
        <div class="card">
          {(events ?? []).length === 0 ? <p class="muted mb-0">No upcoming events are scheduled yet.</p> : (
            <ul class="list">
              {(events ?? []).map((e) => { const d = dateParts(e.starts_at); return (
                <li class="event-row">
                  <div class="date-chip" aria-hidden="true"><b>{d.month}</b><span>{d.day}</span></div>
                  <div>
                    <strong>{e.title}</strong>
                    <div class="small muted">{d.weekday}, {fmtDate(e.starts_at, { month: 'long', day: 'numeric' })} at {fmtTime(e.starts_at)}{e.location && <> &middot; {e.location}</>}</div>
                  </div>
                </li>
              ); })}
            </ul>
          )}
        </div>
      </div>
      <div>
        <h2 class="mb-2">Community news</h2>
        <div class="stack">
          {(news ?? []).map((n) => (
            <article class="card">
              <div class="row"><h3 class="mb-0">{n.title}</h3>{n.pinned && <span class="badge badge-amber">Featured</span>}</div>
              <p class="small muted mt-1">{fmtDate(n.published_at)}</p>
              <p class="pre-line mb-0">{n.body}</p>
            </article>
          ))}
          {(news ?? []).length === 0 && <p class="empty">No announcements right now.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Get things done</p>
      <h2>Everything in one place</h2>
      <div class="grid grid-3 mt-3">
        <a class="card card-link" href="/documents"><div class="card-icon"><Icon name="file" size={22} /></div><h3>Governing documents</h3><p class="small muted">Covenants, by-laws, architectural guidelines and facility rules.</p></a>
        <a class="card card-link" href="/forms"><div class="card-icon"><Icon name="check" size={22} /></div><h3>Forms &amp; requests</h3><p class="small muted">Submit architectural requests and storage applications online and track their status.</p></a>
        <a class="card card-link" href="/members/financials"><div class="card-icon"><Icon name="chart" size={22} /></div><h3>Interactive financials <span class="badge badge-lock"><Icon name="lock" size={12} /> Owners</span></h3><p class="small muted">See where dues go, year by year, with budgets, reserves and capital projects.</p></a>
        <a class="card card-link" href="/members/votes"><div class="card-icon"><Icon name="ballot" size={22} /></div><h3>Online voting <span class="badge badge-lock"><Icon name="lock" size={12} /> Owners</span></h3><p class="small muted">Secure, secret ballots with one vote per lot, with results the moment voting closes.</p></a>
        <a class="card card-link" href="/realtors"><div class="card-icon"><Icon name="home" size={22} /></div><h3>Buying or selling?</h3><p class="small muted">Disclosure packet and governing documents for realtors and closing agents.</p></a>
        <a class="card card-link" href="/contact"><div class="card-icon"><Icon name="mail" size={22} /></div><h3>Contact the board</h3><p class="small muted">Questions about dues, rules or the community? Send us a message.</p></a>
      </div>
    </div>
  </section>
</Base>
