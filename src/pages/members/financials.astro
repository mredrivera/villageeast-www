---
import Shell from '~/layouts/Shell.astro';
import DocList, { type Doc } from '~/components/DocList.astro';
import { ACCOUNT_BALANCES, EXPENSE_CATEGORIES, RESERVE, YEARS } from '~/data/finance';
import { fmtDate, fmtMoney } from '~/lib/format';

const { data: docs } = await Astro.locals.supabase.from('documents')
  .select('id,title,description,doc_date,file_name,size_bytes,visibility,is_archived').eq('category', 'financial')
  .order('doc_date', { ascending: false });
const current = ((docs ?? []) as Doc[]).filter((d) => !d.is_archived);
// Members-only data travels inside this authenticated page, never in a public script bundle.
const payload = JSON.stringify({ years: YEARS, reserve: RESERVE, categories: EXPENSE_CATEGORIES }).replace(/</g, '\\u003c');
const latest = YEARS[YEARS.length - 1]!;
const totalBalance = ACCOUNT_BALANCES.accounts.reduce((t, a) => t + a.amount, 0);
---
<Shell title="Financials" area="members">
  <p class="eyebrow">Owners only</p>
  <h1>Where your dues go</h1>
  <p class="lead">Seven years of Village East income and spending, transcribed from the treasurer's published reports. Pick a year, hover for detail, and open the source report any time.</p>

  <div class="spread mt-3 mb-2">
    <div class="segmented" role="group" aria-label="Year" id="year-picker">
      {YEARS.map((y) => <button type="button" data-year={y.year} aria-pressed={y.year === latest.year ? 'true' : 'false'}>{y.year}</button>)}
    </div>
    <span class="small muted" id="year-source"></span>
  </div>

  <div class="kpi-grid" id="kpis" aria-live="polite"></div>
  <p class="flash flash-info small" id="year-note" hidden></p>

  <section class="card mt-3">
    <div class="spread"><h2 class="mb-0" style="font-size:1.3rem">Follow the money: <span id="flow-year"></span></h2><span class="small muted">Income on the left, spending on the right</span></div>
    <div class="chart chart-tall" id="chart-flow" role="img" aria-label="Flow of income into spending categories for the selected year. The same figures are in the table below."></div>
  </section>

  <div class="grid grid-2 mt-3">
    <section class="card">
      <div class="spread"><h2 class="mb-0" style="font-size:1.3rem">Spending by area</h2>
        <div class="segmented" role="group" aria-label="Include capital projects" id="capital-toggle">
          <button type="button" data-capital="0" aria-pressed="true">Operating</button>
          <button type="button" data-capital="1" aria-pressed="false">+ Capital projects</button>
        </div>
      </div>
      <div class="chart" id="chart-trend" role="img" aria-label="Stacked bars of spending by category for each year."></div>
    </section>
    <section class="card">
      <h2 style="font-size:1.3rem">Income vs. spending</h2>
      <div class="chart" id="chart-net" role="img" aria-label="Lines comparing total income and total spending for each year."></div>
    </section>
  </div>

  <div class="grid grid-2 mt-3">
    <section class="card">
      <h2 style="font-size:1.3rem">Budget vs. actual: <span id="budget-year"></span></h2>
      <div class="chart chart-sm" id="chart-budget" role="img" aria-label="Budgeted and actual operating spending by category for the selected year."></div>
      <p class="small muted mb-0" id="budget-empty" hidden>No category budget was published with this year's report.</p>
    </section>
    <section class="card">
      <h2 style="font-size:1.3rem">Reserve fund</h2>
      <div class="chart chart-sm" id="chart-reserve" role="img" aria-label="Reserve fund balance at the start of each year, actual and projected."></div>
      <p class="small muted mb-0">Start-of-year balance from the reserve analysis approved March 2024. Dashed years are the board's forward plan.</p>
    </section>
  </div>

  <section class="card mt-3">
    <div class="spread"><h2 class="mb-0" style="font-size:1.3rem">Line by line: <span id="table-year"></span></h2><span class="small muted">Change is against the prior year</span></div>
    <div class="table-wrap mt-2"><table class="table" id="detail-table"><thead><tr><th>Category</th><th>Item</th><th class="num">Amount</th><th class="num">Prior year</th><th class="num">Change</th></tr></thead><tbody></tbody></table></div>
  </section>

  <div class="grid grid-2 mt-3">
    <section class="card">
      <h2 style="font-size:1.3rem">Capital projects &amp; reserves</h2>
      <div class="table-wrap"><table class="table table-compact"><thead><tr><th>Year</th><th>Project</th><th class="num">Amount</th></tr></thead><tbody>
        {RESERVE.flatMap((r) => r.projects.map((p) => (<tr><td>{r.year}{r.projected && <span class="badge badge-sand" style="margin-left:6px">Planned</span>}</td><td>{p.name}</td><td class="num">{fmtMoney(p.amount)}</td></tr>)))}
      </tbody></table></div>
    </section>
    <section class="card">
      <h2 style="font-size:1.3rem">Account balances</h2>
      <p class="small muted">As of {fmtDate(ACCOUNT_BALANCES.asOf)}, from the {ACCOUNT_BALANCES.source}.</p>
      <dl class="dl">{ACCOUNT_BALANCES.accounts.map((a) => <><dt>{a.name}</dt><dd>{fmtMoney(a.amount)}</dd></>)}<dt><strong>Total</strong></dt><dd><strong>{fmtMoney(totalBalance)}</strong></dd></dl>
      <h3 class="mt-3">Source reports</h3>
      <DocList docs={current.slice(0, 6)} />
      <details class="mt-2"><summary class="small">All {current.length} financial documents</summary><DocList docs={current.slice(6)} /></details>
    </section>
  </div>
  <script type="application/json" id="finance-data" set:html={payload} />
</Shell>
<script>
  import '~/scripts/finance';
</script>
