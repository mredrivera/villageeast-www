---
import Base from '~/layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap narrow section center">
    <p class="eyebrow">404</p>
    <h1>We couldn't find that page</h1>
    <p class="lead" style="margin-inline:auto">It may have moved when the site was reorganized.</p>
    <div class="row" style="justify-content:center"><a class="btn btn-primary" href="/">Home</a><a class="btn btn-ghost" href="/documents">Documents</a><a class="btn btn-ghost" href="/contact">Contact</a></div>
  </div>
</Base>
