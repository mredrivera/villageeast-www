---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import facts from '~/data/community-facts.json';
import { site } from '~/data/site';
const items = [
  { icon: 'pool', title: 'Swimming pool', photo: '/photos/pool.jpg', text: 'The community pool is open through the summer season and looked after by a pool caretaker. Pool rules are in the Facility Rules and Requirements.' },
  { icon: 'home', title: 'Clubhouse', photo: '/photos/clubhouse.jpg', text: 'The pool clubhouse at 402 Indian Ridge Drive hosts the annual membership meeting, potlucks and Social Club events.' },
  { icon: 'court', title: 'Activity courts', photo: '/photos/courts.jpg', text: 'Tennis, pickleball and basketball on the resurfaced multi-purpose court.' },
  { icon: 'ramp', title: 'Private gated boat ramp', photo: '/photos/ramp.jpg', text: 'Launch from our own paved ramp with a gated entrance for owners.' },
  { icon: 'boat', title: 'Day dock', photo: '/photos/dock.jpg', text: 'Tie up at the community day dock on the Roanoke River channel near marker R26.' },
  { icon: 'grid', title: 'Boat & trailer storage', photo: '/photos/storage.jpg', text: 'Two storage lots for owners. Apply online and the Grounds Committee will assign a space.' },
  { icon: 'road', title: 'Private roads', photo: '/photos/entrance.jpg', text: 'The association maintains all subdivision roads, including paving, patching and snow removal.' },
  { icon: 'sun', title: 'Green belt', photo: '/photos/greenbelt.jpg', text: 'Shared green belt parcels preserve trees and open space throughout the community.' },
  { icon: 'boat', title: 'On the lake', photo: '/photos/lake.jpg', text: 'Village East sits on the Roanoke River channel of Smith Mountain Lake, on the Bedford County shore.' },
];
const civic = [
  { icon: 'fire', label: 'Fire district', value: facts.fireDistrict ? `${facts.fireDistrict.NAME} (${facts.fireDistrict.CompanyNumber})` : null },
  { icon: 'school', label: 'Elementary school', value: facts.elementary?.SCHOOL },
  { icon: 'school', label: 'Middle school', value: facts.middle?.MIDDLE_SCHOOL },
  { icon: 'school', label: 'High school', value: facts.high?.HIGH_SCHOOL },
  { icon: 'vote', label: 'Voting precinct', value: facts.precinct ? `${facts.precinct.Precinct} (#${facts.precinct.PrecinctNumber})` : null },
  { icon: 'trash', label: 'Nearest collection center', value: facts.collectionCenter ? `${facts.collectionCenter.SITE_NAME}, ${facts.collectionCenter.miles} mi` : null },
  { icon: 'map', label: 'Zoning', value: facts.zoning ? `${facts.zoning.ZONING}: ${facts.zoning.ZONING_DISTRICT}` : null },
].filter((c) => c.value);
---
<Base title="Amenities" description="Pool, clubhouse, courts, private boat ramp, day dock and boat storage at Village East on Smith Mountain Lake.">
  <div class="page-head"><div class="wrap">
    <p class="eyebrow">Life at Village East</p>
    <h1>Amenities</h1>
    <p class="lead">Owners share a pool and clubhouse, courts, a private gated boat ramp with a day dock, and two boat trailer storage lots.</p>
  </div></div>
  <section class="section-tight"><div class="wrap">
    <div class="grid grid-3">
      {items.map((a) => (<div class="card card-media"><img class="card-photo" src={a.photo} alt={`${a.title} at Village East`} width="800" height="600" loading="lazy" decoding="async" /><div class="card-body"><h3><Icon name={a.icon} size={18} /> {a.title}</h3><p class="small muted">{a.text}</p></div></div>))}
    </div>
    <div class="row mt-3">
      <a class="btn btn-primary" href="/map"><Icon name="map" size={18} /> Find them on the map</a>
      <a class="btn btn-ghost" href="/documents#rules">Facility rules</a>
      <a class="btn btn-ghost" href="/forms">Apply for boat storage</a>
    </div>
  </div></section>
  <section class="section band-sand"><div class="wrap">
    <p class="eyebrow">Good to know</p>
    <h2>Local services for {site.name}</h2>
    <p class="muted">From Bedford County's public GIS records for the centre of the community.</p>
    <div class="grid grid-3 mt-2">
      {civic.map((c) => (<div class="card"><div class="row"><Icon name={c.icon} /><span class="small muted">{c.label}</span></div><p class="mt-1 mb-0"><strong>{c.value}</strong></p></div>))}
    </div>
  </div></section>
</Base>
