---
import Shell from '~/layouts/Shell.astro';
import Icon from '~/components/Icon.astro';
import { isAdmin } from '~/lib/auth';
import { fmtDateTime } from '~/lib/format';
const db = Astro.locals.supabase;
const admin = isAdmin(Astro.locals.profile);
const count = async (table: string, build: (q: any) => any = (q) => q) => (await build(db.from(table).select('id', { count: 'exact', head: true }))).count ?? 0;
const [openRequests, unread, pendingAccess, members, responses, votes, log] = await Promise.all([
  count('form_submissions', (q) => q.in('status', ['submitted', 'in_review', 'needs_info'])),
  count('contact_messages', (q) => q.eq('handled', false)),
  admin ? count('access_requests', (q) => q.eq('status', 'pending')) : 0,
  count('profiles', (q) => q.eq('status', 'approved')),
  count('survey_responses'),
  db.from('ballots').select('id', { count: 'exact', head: true }).eq('status', 'published').then((r) => r.count ?? 0),
  admin ? db.from('audit_log').select('id,action,entity,created_at,meta').order('created_at', { ascending: false }).limit(12).then((r) => r.data ?? []) : [],
]);
const tiles = [
  { href: '/admin/requests', label: 'Open requests', value: openRequests, icon: 'inbox' },
  { href: '/admin/messages', label: 'Unread messages', value: unread, icon: 'mail' },
  ...(admin ? [{ href: '/admin/members', label: 'Access requests', value: pendingAccess, icon: 'users' }] : []),
  { href: '/admin/members', label: 'Active members', value: members, icon: 'user' },
  { href: '/admin/surveys', label: 'Survey responses', value: responses, icon: 'check' },
  { href: '/admin/votes', label: 'Published ballots', value: votes, icon: 'ballot' },
];
---
<Shell title="Admin" area="admin">
  <p class="eyebrow">Administration</p>
  <h1>Overview</h1>
  <div class="kpi-grid">
    {tiles.map((t) => (<a class="kpi card-link" href={t.href} style="text-decoration:none"><div class="kpi-label"><Icon name={t.icon} size={14} /> {t.label}</div><div class="kpi-value">{t.value}</div></a>))}
  </div>
  {admin && (
    <section class="card mt-3">
      <h2 style="font-size:1.25rem">Recent activity (audit log)</h2>
      {log.length === 0 ? <p class="muted mb-0">No activity yet.</p> : (
        <div class="table-wrap"><table class="table"><thead><tr><th>When</th><th>Action</th><th>Detail</th></tr></thead><tbody>
          {log.map((l) => <tr><td>{fmtDateTime(l.created_at)}</td><td>{l.action.replace(/_/g, ' ')}</td><td class="small muted">{l.entity ?? ''} {Object.entries(l.meta ?? {}).map(([k, v]) => `${k}: ${String(v)}`).join(', ')}</td></tr>)}
        </tbody></table></div>
      )}
    </section>
  )}
</Shell>
